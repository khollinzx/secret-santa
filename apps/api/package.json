{
  "name": "@santa/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/mail-delivery.mjs dist/mail-delivery.mjs && mkdir -p dist/packages/domain && cp ../../packages/domain/draw.mjs dist/packages/domain/draw.mjs && node ../../scripts/fix-api-import.mjs",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "seed:admin": "tsx src/seed-admin.ts",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0"
  }
}
