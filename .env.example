# Copy to .env. Use unique URL-safe random values for both passwords.
MYSQL_DATABASE=secret_santa
MYSQL_USER=santa
MYSQL_PASSWORD=replace-with-a-long-random-alphanumeric-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=mysql://santa:replace-with-a-long-random-alphanumeric-password@127.0.0.1:3306/secret_santa
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# Set at frontend BUILD time. Leave blank only for browser sample-data preview.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PARTICIPANT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only needed when running the one-time admin seed. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
