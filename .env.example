# Supabase: paste the SESSION POOLER connection string securely into Render.
# Get its actual hostname from your project's Connect dialog; never guess it.
DATABASE_URL=postgresql://postgres:replace-with-local-dev-password@127.0.0.1:5432/secret_santa
POSTGRES_DB=secret_santa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-dev-password
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PARTICIPANT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Optional trusted CA certificate if required by the database TLS chain.
DATABASE_SSL_CA=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email delivery: enable only after configuring a verified sender and provider API key.
MAIL_WORKER_ENABLED=false
MAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
